# Copy to local.env (gitignored) and fill in for your cluster. Sourced by common.sh and submit_chain.sh.
# SLURM account to charge; submit_chain.sh passes it as --account. Leave empty to use your default association
# (plain `sbatch scripts/multigpu/<job>.sbatch` runs use the default unless you add --account yourself).
AR_ACCOUNT=
# Proxy for compute nodes without direct internet access (pip and dataset downloads). Leave empty if not needed.
AR_PROXY=
# Optional overrides, defaults in common.sh / submit_chain.sh: AR_ROOT, AR_BASE_PY, AR_EXCLUDE
